generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BookingType {
  PICKUP
  DROPOFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  WHATSAPP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vehicle {
  id           String    @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  capacity     Int
  basePrice    Decimal   @db.Decimal(10, 2)
  pricePerKm   Decimal   @db.Decimal(10, 2) @default(0)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model Media {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String     @unique
  alt          String?
  caption      String?
  folder       String     @default("general")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  blogPosts    BlogPost[]
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @db.Text
  category        String
  publishedAt     DateTime
  readTime        String   @default("5 min read")
  imageUrl        String?
  imageAlt        String?
  imageMediaId    String?
  imageMedia      Media?   @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  sections        Json
  contentHtml     String?  @db.Text
  isPublished     Boolean  @default(true)
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

enum CorporateEnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
  SPAM
}

model CorporateEnquiry {
  id           String                  @id @default(cuid())
  reference    String                  @unique
  company      String
  contactName  String
  email        String
  phone        String
  serviceType  String
  message      String                  @db.Text
  status       CorporateEnquiryStatus  @default(NEW)
  adminNotes   String?                 @db.Text
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  type            BookingType
  status          BookingStatus @default(PENDING)
  pickupLocation  String
  dropoffLocation String
  pickupDate      DateTime
  flightNumber    String?
  passengerCount  Int
  luggageCount    Int           @default(0)
  customerName    String
  customerEmail   String
  customerPhone   String
  specialRequests String?
  quotedPrice     Decimal       @db.Decimal(10, 2)
  distanceKm      Decimal?      @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(WHATSAPP)
  paymentStatus   PaymentStatus @default(PENDING)
  paystackReference String?
  adminNotes      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([pickupDate])
  @@index([customerPhone])
}

model CmsPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  excerpt          String?  @db.Text
  content          String   @db.Text
  featuredImageUrl String?
  featuredImageAlt String?
  metaTitle        String?
  metaDescription  String?  @db.Text
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
